# Copy this file to ".env" and fill in the values. Never share .env with anyone.

# From @BotFather in Telegram (looks like 1234567890:AAF...)
TELEGRAM_BOT_TOKEN=

# From https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=

# Leave empty at first. Message your bot and it will tell you your ID.
ALLOWED_USER_ID=

# Fast model for everyday chat and logging (replies in ~2-3 seconds).
GEMINI_MODEL=gemini-flash-lite-latest

# Smarter, slower model for monthly reports and news. Each model is the
# other's backup when Google is busy or a quota runs out.
GEMINI_SMART_MODEL=gemini-flash-latest

# Your Google Cloud project ID (Firestore lives here), e.g. mosshybot-123456
GOOGLE_CLOUD_PROJECT=

# Cloud version only: two long random strings (any random text works)
TELEGRAM_WEBHOOK_SECRET=
JOB_SECRET=

# What the bot calls you (optional)
OWNER_NAME=

# Optional: a nicer web address for /dashboard (Firebase Hosting), e.g. https://moss-alya.web.app
DASHBOARD_URL=

# Optional: Jev (TypeSafe) message router, from console.typesafe.ai. Empty = off.
TYPESAFE_API_KEY=

# Optional: secret for the iPhone Siri Shortcuts (any long random text)
SHORTCUT_SECRET=
